rules_version = '2';
// Reglas de seguridad de Freshkito.
// Pégalas en: Consola de Firebase → Firestore Database → Reglas → Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hhPath(hid) { return /databases/$(database)/documents/households/$(hid); }

    // Perfil propio
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Códigos de invitación: solo se pueden leer sabiendo el código exacto
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.auth.uid in getAfter(hhPath(request.resource.data.householdId)).data.members;
      allow update, delete: if false;
    }

    match /households/{hid} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Los miembros pueden editar. Alguien de fuera solo puede añadirse a sí mismo (con el código de invitación).
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
        )
      );
      allow delete: if false;

      // Alimentos, lista de la compra y códigos de barras: solo miembros
      match /{col}/{docId} {
        allow read: if signedIn() && request.auth.uid in get(hhPath(hid)).data.members;
        allow write: if signedIn() && request.auth.uid in getAfter(hhPath(hid)).data.members;
      }
    }
  }
}
